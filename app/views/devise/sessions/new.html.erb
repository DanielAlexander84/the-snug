<div class="max-w-sm mx-auto mt-24">
  <h2 class="text-xl mb-4">Come into the snug</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field mb-4">
      <p><%= f.label :email %></p>
      <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "border rounded px-2 py-1 w-full" %></p>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field mb-4">
        <p><%= f.check_box :remember_me %> <%= f.label :remember_me %></p>
      </div>
    <% end %>

    <div class="actions">
      <%= f.submit "Send me a magic link", class: "border rounded px-3 py-1" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
